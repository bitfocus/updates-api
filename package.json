{
  "name": "companion-updates-api",
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file .env --watch src/main.ts",
    "build": "run db:generate && tsc -p tsconfig.json",
